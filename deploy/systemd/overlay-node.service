[Unit]
Description=Tonnet Messenger 0.4 authoritative room sequencer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tonnet
Group=tonnet
StateDirectory=tonnet
ConfigurationDirectory=tonnet
Environment=TONNET_MAX_LEAVES=256
EnvironmentFile=/etc/tonnet/tonnet.env
ExecStart=/usr/local/bin/tonnet-messenger-server serve --state /var/lib/tonnet --listen 0.0.0.0:17400 --advertise ${TONNET_ADVERTISE} --max-leaves ${TONNET_MAX_LEAVES}
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

MemoryHigh=512M
MemoryMax=768M
TasksMax=512
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
